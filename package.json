{
  "name": "seyn-desktop",
  "version": "1.1.0",
  "description": "Seyn desktop music player",
  "author": {
    "name": "Seyn",
    "email": "barveatharva57@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "fluent-ffmpeg": "^2.1.3",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "electron": "38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.seyn.app",
    "productName": "Seyn",
    "files": [
      "**/*",
      "!**/.git{,/**/*}",
      "!**/.venv{,/**/*}",
      "!**/build{,/**/*}",
      "!**/*.log"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      },
      {
        "from": "python-runtime",
        "to": "python-runtime"
      }
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/seyn-logo.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons",
      "category": "AudioVideo",
      "desktop": {
        "entry": {
          "Icon": "/usr/share/icons/hicolor/512x512/apps/seyn-desktop.png"
        }
      }
    }
  }
}
