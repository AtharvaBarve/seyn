{
  "name": "vimusic-desktop",
  "version": "1.0.0",
  "description": "ViTune desktop music player",
  "author": "ViTune",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "fluent-ffmpeg": "^2.1.3",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "electron": "38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.vimusic.app",
    "productName": "ViTune",
    "files": [
      "**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/vitune.ico"
    }
  }
}
